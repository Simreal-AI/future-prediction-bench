# Optional live services. Set these in your shell or deployment secret store.
# The CLI reads process environment variables; it does not load .env automatically.
# Never commit a populated .env file.

# Evaluated agent: a Chat Completions-compatible endpoint, key, and model identifier.
# The base URL should end at the API root, such as /v1, not /chat/completions.
FPB_MODEL_BASE_URL=
FPB_MODEL_API_KEY=
FPB_MODEL_NAME=

# Brave Search credentials for the self_research condition.
# Not needed for source collection or the no_search ablation.
FPB_BRAVE_API_KEY=

# Fixed private fallback baseline, configured independently of the evaluated agent.
# No network search is used by the current internal baseline.
FPB_BASELINE_BASE_URL=
FPB_BASELINE_API_KEY=
FPB_BASELINE_MODEL_NAME=
